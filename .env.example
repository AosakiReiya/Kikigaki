# Cloudflare D1（drizzle-kit 遠端操作需要；wrangler 指令走 OAuth 登入即可）
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# Cloudflare Turnstile（評論反垃圾；未設定時本地開發自動跳過驗證）
# 儀表板 → Turnstile → 新增 site（managed 模式），widget 的 action 用 submit_comment
# widget 的 allowed domains 記得加：你的正式域、preview 域、localhost, 127.0.0.1
# Pages 部署：在專案 Settings → Environment variables 新增同名變數（也可放 .dev.vars 供本地開發）
TURNSTILE_SECRET=""
PUBLIC_TURNSTILE_SITE_KEY=""
# 選填：允許的 frontend hostname（逗號分隔，如 blog.example.com,example.com）。
# 未設定則不檢查 hostname。注意：本地開發請留空（localhost 不會在白名單內，會被擋）。
TURNSTILE_HOSTNAMES=""

# --- Commerce (Phase 79e, all optional — unset = shop dormant) ---
# PAYMENT_PROVIDER="stripe,paypal"     comma list; unset = every keyed provider
# STRIPE_SECRET="sk_test_..."          STRIPE_WEBHOOK_SECRET="whsec_..."
# PAYPAL_CLIENT_ID="" PAYPAL_SECRET="" PAYPAL_WEBHOOK_ID="" PAYPAL_ENV="live"
# AIRWALLEX_CLIENT_ID="" AIRWALLEX_API_KEY="" AIRWALLEX_WEBHOOK_SECRET="" AIRWALLEX_ENV="prod"
# COMMERCE_CURRENCY="usd"              zero-decimal: jpy / twd
# PAYMENT_PROVIDER="mock" + ALLOW_MOCK_PAYMENTS="1"  = local demo ONLY (dev/.dev.vars)
