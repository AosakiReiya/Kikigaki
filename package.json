{
	"name": "kikigaki",
	"private": true,
	"packageManager": "pnpm@10.32.1",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"theme:create": "node scripts/theme-create.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --ignore 'tests/fixtures/**'",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"backup:d1": "mkdir -p backups && wrangler d1 export kikigaki --remote --output=backups/kikigaki-$(date +%Y%m-%dT%H%M).sql",
		"backup:d1:local": "mkdir -p backups && wrangler d1 export kikigaki --local --output=backups/kikigaki-local-$(date +%Y%m-%dT%H%M).sql",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"admin:create": "node scripts/create-admin.ts",
		"admin:create:local": "node scripts/create-admin.ts --local",
		"admin:create:prod": "node scripts/create-admin.ts --remote",
		"content:import": "node scripts/import-md.ts",
		"content:import:local": "node scripts/import-md.ts --local",
		"content:import:prod": "node scripts/import-md.ts --remote",
		"admin:password:local": "node scripts/change-password.ts --local",
		"admin:password:prod": "node scripts/change-password.ts --remote",
		"deploy:pages": "wrangler pages deploy .svelte/cloudflare --project-name kikigaki",
		"deploy:site": "pnpm build && pnpm deploy:pages",
		"deploy:content": "pnpm content:import:prod && pnpm deploy:site",
		"deploy:all": "pnpm lint && pnpm check && node scripts/check-env.ts && pnpm deploy:site",
		"i18n:sync": "node scripts/i18n-sync.mjs",
		"i18n:check": "node scripts/i18n-sync.mjs --check",
		"i18n:add": "node scripts/i18n-add.mjs",
		"i18n:remove": "node scripts/i18n-remove.mjs",
		"cf:setup": "node scripts/cf-bootstrap.mjs",
		"seed:demo": "node scripts/seed-demo.mjs --posts",
		"seed:demo:remote": "node scripts/seed-demo.mjs --posts --remote",
		"seed:wipe": "node scripts/seed-demo.mjs --wipe",
		"seed:theme": "node scripts/seed-demo.mjs --theme"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "latest",
		"@cloudflare/workers-types": "^5.20260823.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@storybook/addon-a11y": "^10.5.10",
		"@storybook/addon-docs": "^10.5.10",
		"@storybook/addon-svelte-csf": "latest",
		"@storybook/addon-vitest": "^10.5.10",
		"@storybook/sveltekit": "^10.5.10",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24",
		"@types/sanitize-html": "^2.16.1",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.8",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.5.10",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.7",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"rehype-slug": "^6.0.0",
		"storybook": "^10.5.10",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.132.0"
	},
	"dependencies": {
		"@cartamd/plugin-attachment": "^4.2.0",
		"@fontsource/fira-mono": "^5.3.0",
		"@fontsource/space-grotesk": "^5.3.0",
		"@node-rs/argon2": "^2.1.0",
		"@node-rs/argon2-wasm32-wasi": "^2.1.0",
		"@types/markdown-it": "^14.2.0",
		"better-sqlite3": "^13.0.3",
		"carta-md": "^4.11.2",
		"chart.js": "^4.5.1",
		"fflate": "^0.8.3",
		"github-slugger": "^2.0.0",
		"gray-matter": "^4.0.3",
		"gsap": "^3.15.0",
		"markdown-it": "^15.0.0",
		"sanitize-html": "^2.17.7"
	}
}
